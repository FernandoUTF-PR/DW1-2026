const API_BASE_URL = 'http://localhost:3001';

// Variável global para armazenar o email durante todo o fluxo
let emailGlobal = '';

// 🔹 Função auxiliar para trocar os cards visíveis
function mostrarCard(idParaMostrar) {
    document.getElementById('cardEmail').classList.add('hidden');
    document.getElementById('cardSenha').classList.add('hidden');
    document.getElementById('cardCadastro').classList.add('hidden');
    
    document.getElementById(idParaMostrar).classList.remove('hidden');
}

// 🔹 Volta para a etapa escolhida e limpa campos sensíveis
function voltarPara(idParaVoltar) {
    document.getElementById('mensagemErro').innerText = '';
    document.getElementById('senha').value = '';
    document.getElementById('senhaCadast').value = '';
    mostrarCard(idParaVoltar);
}

// 🔹 Etapa 1: Verifica se o e-mail existe
async function verificarEmail() {
    const emailInput = document.getElementById("email").value.trim();
    emailGlobal = emailInput;

    try {
        const response = await fetch(`${API_BASE_URL}/login/verificarEmail`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailGlobal })
        });

        const data = await response.json();
        console.log("Resposta do servidor: " + (data.nome || "N/A") + " - " + data.status);

        if (data.status === 'existe') {
            // Vai para a Senha
            document.getElementById("nomeUsuario").innerText = `Olá, ${data.nome}`;
            mostrarCard('cardSenha');
            document.getElementById("senha").focus();
        } else {
            // Vai para o Cadastro
            const desejaCadastrar = confirm("E-mail não encontrado. Deseja se cadastrar?");
            if (desejaCadastrar) {
                document.getElementById('emailCadast').value = emailGlobal;
                mostrarCard('cardCadastro');
                document.getElementById("nameCadast").focus();
            }
        }
    } catch (error) {
        console.error("Erro ao verificar email:", error);
        alert("Erro ao se conectar com o servidor.");
    }
}

// 🔹 Etapa 2: Valida a senha e realiza login
async function realizarLogin(event) {
    event.preventDefault();
    const senha = document.getElementById("senha").value;
    const mensagemErro = document.getElementById("mensagemErro");
    mensagemErro.innerText = '';

    if (!senha) {
        mensagemErro.innerText = 'Por favor, informe sua senha.';
        return;
    }

    try {
        const response = await fetch(`${API_BASE_URL}/login/verificarSenha`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ email: emailGlobal, senha })
        });

        const data = await response.json();

        if (data.status === 'ok') {
            window.location.href = '/menu';
        } else if (data.status === 'senha_incorreta') {
            mensagemErro.innerText = 'Senha incorreta. Tente novamente.';
        } else {
            mensagemErro.innerText = 'Erro ao efetuar login.';
        }
    } catch (error) {
        console.error('Erro ao realizar login:', error);
        mensagemErro.innerText = 'Falha ao se comunicar com o servidor.';
    }
}

// 🔹 Etapa 3: Processa o cadastro no servidor
async function cadastrarUsuario() {
    const nome = document.getElementById("nameCadast").value.trim();
    const senha = document.getElementById("senhaCadast").value;
    const email = document.getElementById("emailCadast").value;

    if (!nome || !senha) {
        alert("Por favor, preencha seu nome e defina uma senha.");
        return;
    }

    try {
        // Crie uma rota /login/cadastrar no seu Express (server.js) para receber isso
        const response = await fetch(`${API_BASE_URL}/login/cadastrar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, nome, senha })
        });

        const data = await response.json();

        if (data.status === 'sucesso') {
            alert("Cadastro realizado com sucesso! Faça login para continuar.");
            voltarPara('cardEmail');
        } else {
            alert("Erro ao realizar cadastro: " + (data.mensagem || "Erro desconhecido."));
        }
    } catch (error) {
        console.error('Erro ao cadastrar:', error);
        alert("Falha ao se comunicar com o servidor no cadastro.");
    }
}

// 🔹 Ação de Esqueci a Senha
function esqueciSenha() {
    alert("Função de recuperação de senha em desenvolvimento.");
}
