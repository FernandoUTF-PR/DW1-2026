<main class="login-container">
    
    <!-- ETAPA 1: INSERIR E-MAIL -->
    <section class="login-card" id="cardEmail">
        <h2>Padaria Padarado Pardal Pardo</h2>
        <h2>LOGIN</h2>
        <form id="formEmail" onsubmit="event.preventDefault(); verificarEmail();">
            <div class="form-group">
                <label for="email">E-mail (só Gmail)</label>
                <input type="email" id="email" placeholder="seuemail@exemplo.com" required>
                <button type="submit" class="btn-primary">Avançar</button>
            </div>
        </form>
    </section>

    <!-- ETAPA 2: SENHA (Oculta por padrão) -->
    <section class="login-card hidden" id="cardSenha">
        <h2>Entrar</h2>
        <p id="nomeUsuario" class="saudacao"></p>
        <form id="formSenha" onsubmit="realizarLogin(event)">
            <div class="form-group">
                <label for="senha">Senha</label>
                <input type="password" id="senha" placeholder="Sua senha" required>
                <p id="mensagemErro" class="erro-msg"></p>
                <div class="btn-group">
                    <button type="button" class="btn-secondary" onclick="voltarPara('cardEmail')">Voltar</button>
                    <button type="submit" class="btn-primary">Entrar</button>
                </div>
            </div>
        </form>
    </section>

    <!-- ETAPA 3: CADASTRO (Oculta por padrão) -->
    <section class="login-card hidden" id="cardCadastro">
        <h2>Cadastrar (Sign Up)</h2>
        <form id="formCadastro">
            <div class="form-group">
                <label for="emailCadast">E-mail</label>
                <input type="email" id="emailCadast" readonly> <!-- Pode vir preenchido da etapa 1 -->
                
                <label for="nameCadast">Nome (real)</label>
                <input type="text" id="nameCadast" required>
                
                <label for="senhaCadast">Senha</label>
                <input type="password" id="senhaCadast" required>
                
                <div class="btn-group">
                    <button type="button" class="btn-secondary" onclick="voltarPara('cardEmail')">Voltar</button>
                    <button type="button" class="btn-primary" onclick="cadastrarUsuario()">Finalizar Cadastro</button>
                </div>
            </div>
        </form>
    </section>

</main>
